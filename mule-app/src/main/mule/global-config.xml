<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:jms="http://www.mulesoft.org/schema/mule/jms"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/jms http://www.mulesoft.org/schema/mule/jms/current/mule-jms.xsd">

    <!--
      Not in the brief's global-config.xml step, but every ${...}
      placeholder below needs a resolution source or the app can't even
      deploy (MUnit included). Originally a <configuration-properties
      file="config.properties" /> element (loading safe, non-secret
      local/test defaults from mule-app/src/main/resources/config.properties)
      here instead; changed to inline ${key:default} placeholder defaults
      while debugging Task 12's Docker deploy. mule-maven-plugin 4.10.1
      (needed to build at all: see pom.xml's comment on that version bump)
      always embeds an "encoding" parameter (with a default value, since we
      never set one) into <configuration-properties>'s serialized AST
      entry, using its own bundled, newer-than-4.6.0 notion of that core
      element's schema; this Mule 4.6.0 runtime's actual
      configuration-properties component model has no such parameter, so
      deploy fails rehydrating the AST with "Could not resolve
      ParameterModel for [encoding]" (confirmed via runtimeVersion=4.6.0
      and skipValidation=true on the plugin too; neither changed what got
      embedded, so the plugin's handling of this specific element seems to
      hardcode a fixed, newer schema either way). Inline defaults use
      Mule's built-in placeholder resolution instead (system properties
      always take precedence over the inline default, same override
      behavior as before), so config.properties is no longer loaded; its
      values are preserved here as the defaults. Real Salesforce
      credentials still live in the gitignored top-level .env and reach
      the runtime as JVM system properties at deployment time, unaffected
      by this change.
    -->

    <http:listener-config name="SF_System_API_Listener_Config">
        <http:listener-connection host="0.0.0.0" port="${sf.system.api.port:8082}" />
    </http:listener-config>

    <http:listener-config name="Feasibility_System_API_Listener_Config">
        <http:listener-connection host="0.0.0.0" port="${feasibility.system.api.port:8083}" />
    </http:listener-config>

    <http:listener-config name="Process_API_Listener_Config">
        <http:listener-connection host="0.0.0.0" port="${process.api.port:8084}" />
    </http:listener-config>

    <http:listener-config name="Experience_API_Listener_Config">
        <http:listener-connection host="0.0.0.0" port="${experience.api.port:8081}" />
    </http:listener-config>

    <http:request-config name="Feasibility_Service_Request_Config">
        <http:request-connection host="${feasibility.host:feasibility}" port="${feasibility.port:5001}" />
    </http:request-config>

    <http:request-config name="SF_System_API_Request_Config">
        <http:request-connection host="${sf.system.api.host:localhost}" port="${sf.system.api.port:8082}" />
    </http:request-config>

    <http:request-config name="Feasibility_System_API_Request_Config">
        <http:request-connection host="${feasibility.system.api.host:localhost}" port="${feasibility.system.api.port:8083}" />
    </http:request-config>

    <!--
      Salesforce REST API, not the packaged Salesforce Connector (that
      connector requires MULE_EE unconditionally per its own bundled
      descriptor, incompatible with this project's Community Edition/
      no-Anypoint-account constraint; discovered and fixed while executing
      Task 5). Auth is OAuth 2.0 JWT Bearer, same flow verified working in
      Task 2, but the token exchange now happens via a plain http:request
      inside salesforce-system-api.xml's get-sfdc-access-token-flow rather
      than a connector-managed connection. One shared request-config
      serves both the token endpoint and the data REST endpoints since
      they're the same host (the org's My Domain instance URL).
    -->
    <http:request-config name="SFDC_Request_Config">
        <http:request-connection host="${sfdc.instance.host:login.salesforce.com}" port="443" protocol="HTTPS" />
    </http:request-config>

    <jms:config name="JMS_Config">
        <jms:active-mq-connection>
            <jms:factory-configuration brokerUrl="${activemq.broker.url:tcp://localhost:61616}" />
        </jms:active-mq-connection>
    </jms:config>

</mule>
