<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:jms="http://www.mulesoft.org/schema/mule/jms"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/jms http://www.mulesoft.org/schema/mule/jms/current/mule-jms.xsd">

    <!--
      Every ${...} placeholder below is resolved purely from JVM system
      properties (the -M-D flags docker-entrypoint.sh always passes),
      no <configuration-properties> file, no inline ${key:default} syntax.
      Two things were tried and ruled out while debugging Task 12's Docker
      deploy:
      1. <configuration-properties file="config.properties" />: this Mule
         4.6.0 runtime's actual configuration-properties component model
         doesn't recognize an "encoding" parameter that mule-maven-plugin
         4.10.1 (needed to build at all, see pom.xml's comment on that
         version) always embeds in the element's serialized AST regardless;
         deploy failed rehydrating the AST with "Could not resolve
         ParameterModel for [encoding]", confirmed unaffected by
         runtimeVersion/skipValidation settings on the plugin.
      2. Inline ${key:default} syntax (a common convention in other
         property-placeholder systems): this runtime's placeholder
         resolver does not treat ':' as a default-value separator at all;
         it reads the whole string, colon included, as one literal
         property name, so deploy failed with PropertyNotFoundException:
         Couldn't find configuration property value for key
         "sf.system.api.port:8082" (i.e. literally that whole string).
      Every property referenced anywhere in this file is unconditionally
      supplied via -M-D by docker-entrypoint.sh for the real deployment,
      so plain ${key} with no default is both correct and sufficient here.
    -->

    <http:listener-config name="SF_System_API_Listener_Config">
        <http:listener-connection host="0.0.0.0" port="${sf.system.api.port}" />
    </http:listener-config>

    <http:listener-config name="Feasibility_System_API_Listener_Config">
        <http:listener-connection host="0.0.0.0" port="${feasibility.system.api.port}" />
    </http:listener-config>

    <http:listener-config name="Process_API_Listener_Config">
        <http:listener-connection host="0.0.0.0" port="${process.api.port}" />
    </http:listener-config>

    <http:listener-config name="Experience_API_Listener_Config">
        <http:listener-connection host="0.0.0.0" port="${experience.api.port}" />
    </http:listener-config>

    <http:request-config name="Feasibility_Service_Request_Config">
        <http:request-connection host="${feasibility.host}" port="${feasibility.port}" />
    </http:request-config>

    <http:request-config name="SF_System_API_Request_Config">
        <http:request-connection host="${sf.system.api.host}" port="${sf.system.api.port}" />
    </http:request-config>

    <http:request-config name="Feasibility_System_API_Request_Config">
        <http:request-connection host="${feasibility.system.api.host}" port="${feasibility.system.api.port}" />
    </http:request-config>

    <!--
      Missing since this file was first written: every other tier has both
      a listener config (for its own inbound side) and a request config
      (for other flows to call it), but Process API only ever had the
      listener half; Experience API's proxy to POST /orders had nothing
      to reference. Found deploying Task 12's Docker stack (the AST/property
      issues fixed above happened to mask this one until they were cleared).
    -->
    <http:request-config name="Process_API_Request_Config">
        <http:request-connection host="${process.api.host}" port="${process.api.port}" />
    </http:request-config>

    <!--
      Salesforce REST API, not the packaged Salesforce Connector (that
      connector requires MULE_EE unconditionally per its own bundled
      descriptor, incompatible with this project's Community Edition/
      no-Anypoint-account constraint; discovered and fixed while executing
      Task 5). Auth is OAuth 2.0 JWT Bearer, same flow verified working in
      Task 2. Data calls go straight to the org's REST API via this config.
    -->
    <http:request-config name="SFDC_Request_Config">
        <http:request-connection host="${sfdc.instance.host}" port="443" protocol="HTTPS" />
    </http:request-config>

    <!--
      The JWT-signing step itself doesn't happen in Mule anymore.
      mule-java-module (needed for java:invoke-static to sign the JWT)
      turned out to be permanently incompatible with this Mule 4.6.0
      standalone runtime: every module version new enough for Java 17
      declares a JavaVersion.JAVA_25 enum constant the runtime's bundled
      mule-sdk-api (0.8.0) doesn't have, and patching the runtime's sdk-api
      to add JAVA_25 support breaks its own EE/DataWeave module
      registration instead, confirmed empirically, no version threads
      the needle (see mule-app/pom.xml's prior mule-java-module dependency
      comment, now removed along with the dependency, and Task 12's
      report for the full diagnostic trail). Discovered and fixed while
      executing Task 12. JWT signing now happens in the small dedicated
      sfdc-auth Python service (services/sfdc-auth/) using the same logic
      already verified working in Task 2. Mule just calls it over plain
      HTTP to get a fresh access token, same as any other System API call
      in this app.
    -->
    <http:request-config name="SFDC_Auth_Request_Config">
        <http:request-connection host="${sfdc.auth.host}" port="${sfdc.auth.port}" />
    </http:request-config>

    <!--
      username/password added deploying Task 12's Docker stack: without
      them the connection reached the Artemis broker fine over OpenWire
      (confirming the activemq-client shared-library fix above worked)
      but failed authentication with "User name [null] or password is
      invalid"; Artemis requires the ARTEMIS_USER/ARTEMIS_PASSWORD
      credentials set in docker-compose.yml, which nothing was providing.
    -->
    <jms:config name="JMS_Config">
        <jms:active-mq-connection username="${activemq.username}" password="${activemq.password}">
            <jms:factory-configuration brokerUrl="${activemq.broker.url}" />
        </jms:active-mq-connection>
    </jms:config>

</mule>
